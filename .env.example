# Kopiera till .env.local för utveckling: cp .env.example .env.local
# Lägg aldrig riktiga hemligheter i den här filen. Den committas till git.

# Miljö: "development" eller "production". Styr banner och standardnivå för loggning.
# Om den utelämnas följer den NODE_ENV.
APP_ENV=development

# Loggnivå: debug, info, warn eller error. Standard: debug i dev, info i prod.
LOG_LEVEL=debug

# Serverhemlighet (valfri). Läses bara på servern och visas aldrig i webbläsaren.
# Använd en platshållare här och lägg det riktiga värdet i .env.local eller på Render.
API_SECRET_KEY=change-me

# Publik variabel. Bakas in vid build och syns för alla i webbläsaren, så den är aldrig hemlig.
NEXT_PUBLIC_APP_NAME=CI/CD-demo
